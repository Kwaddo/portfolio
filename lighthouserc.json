{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "/index.html",
        "/work/tanami/index.html",
        "/personal/games/smobb/index.html",
        "/journal/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci" }
  }
}
