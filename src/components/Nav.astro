---
import { isActive, nav } from '../lib/nav';
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  pathname: string;
}
const { pathname } = Astro.props;
---
<header class="nav">
  <div class="nav__inner wrap">
    <a class="nav__brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(pathname, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn--solid nav__cta" href="/contact/" aria-label="Get in touch"><Icon name="mail" /><span class="nav__cta-text">Get in touch</span></a>
  </div>
</header>
