---
// Monochrome line icons on a 24 grid, drawn by hand; currentColor, 1em, decorative.
interface Props {
  name: 'github' | 'linkedin' | 'rss' | 'mail' | 'arrow-up' | 'arrow-left' | 'arrow-right' | 'external' | 'play' | 'download' | 'code' | 'file';
  class?: string;
}
const { name, class: cls } = Astro.props;
const paths: Record<Props['name'], string> = {
  github: 'M9 19c-4.5 1.4-4.5-2.5-6-3m12 5v-3.5c0-1-.1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
  linkedin: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  rss: 'M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M5 19h.01',
  mail: 'M3 6h18v12H3zM3 7l9 7 9-7',
  'arrow-up': 'M12 19V5M5 12l7-7 7 7',
  'arrow-left': 'M19 12H5M12 19l-7-7 7-7',
  'arrow-right': 'M5 12h14M12 5l7 7-7 7',
  external: 'M14 4h6v6M20 4l-9 9M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5',
  play: 'M7 4l13 8-13 8z',
  download: 'M12 4v12M6 11l6 6 6-6M4 20h16',
  code: 'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  file: 'M14 3H6v18h12V7zM14 3v4h4M9 13h6M9 17h6',
};
// directional icons mirror in RTL
const flip = name === 'arrow-left' || name === 'arrow-right' || name === 'external' || name === 'play';
---
<svg class:list={['icon', flip && 'icon--flip', cls]} viewBox="0 0 24 24" width="1em" height="1em" fill={name === 'play' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width={name === 'play' ? 0 : 2} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>
