---
import type { DevlogItem } from '../lib/journal';
import Strip from './Strip.astro';

interface Props {
  items: DevlogItem[];
}
const { items } = Astro.props;
---
{
  items.length > 0 && (
    <section class="stack" aria-labelledby="devlog-title">
      <h2 id="devlog-title">From the devlog</h2>
      <ol class="strips">
        {items.map((i, n) => <Strip href={i.href} date={i.date} text={i.text} index={n} />)}
      </ol>
    </section>
  )
}
