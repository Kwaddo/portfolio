---
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import '../styles/tone.css';
import '../styles/type.css';
import '../styles/components.css';
import '../styles/nav.css';
import '../styles/panels.css';
import '../styles/media.css';
import '../styles/journal.css';
import '../styles/landing.css';
import '../styles/art.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { canonical, pageTitle } from '../lib/seo';
import { site } from '../data/site';
import { ogImageFor } from '../lib/og';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ar';
  noindex?: boolean;
}
const {
  title,
  description = `${site.name} is a ${site.role.toLowerCase()} in ${site.location}. Work, games and the stories behind them.`,
  lang = 'en',
  noindex = false,
} = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const url = canonical(Astro.url.pathname);
const full = pageTitle(title);
const image = canonical(ogImageFor(Astro.url.pathname));
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: journal`} href="/rss.xml" />
    <meta name="theme-color" content="#fafafa" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      // Marks JS as available (reveal styles apply only then) and remembers whether the landing sequence already played.
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        try {
          if (sessionStorage.getItem('hero')) h.classList.add('seen');
          else sessionStorage.setItem('hero', '1');
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <filter id="ink" x="-8%" y="-8%" width="118%" height="118%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="rough" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="3" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="rough-b" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="11" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="rough-c" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="23" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- boil-a/b/c: the same fine ink at three seeds; motion.css cycles them so lettering shimmers like redrawn line work -->
      <filter id="boil-a" x="-8%" y="-8%" width="116%" height="116%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="5" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="boil-b" x="-8%" y="-8%" width="116%" height="116%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="17" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="boil-c" x="-8%" y="-8%" width="116%" height="116%">
        <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="29" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <Nav pathname={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // Reveal once per element; re-run after every client-side navigation.
      const reveal = () => {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('is-in');
                io.unobserve(en.target);
              }
            }
          },
          // Huge top margin: anything scrolled past (End key, anchor jump, reload mid-page) counts as seen.
          { rootMargin: '100000px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      };
      reveal();
      document.addEventListener('astro:page-load', reveal);
      document.addEventListener('astro:after-swap', () => {
        // The router replaces <html> attributes; restore our flags before paint, then move focus to the new page.
        document.documentElement.classList.add('js', 'seen');
        const main = document.getElementById('main');
        if (main) {
          main.setAttribute('tabindex', '-1');
          main.focus({ preventScroll: true });
        }
      });
    </script>
  </body>
</html>
