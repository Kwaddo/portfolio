---
import Kicker from '../../components/Kicker.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bubble from '../../components/Bubble.astro';
import Panel from '../../components/Panel.astro';
import Sfx from '../../components/Sfx.astro';
import Strip from '../../components/Strip.astro';
import { excerpt, newestFirst, tagsOf, tagSlug } from '../../lib/journal';
import { published } from '../../lib/content';

const entries = newestFirst(published(await getCollection('journal')));
const tags = tagsOf(entries);
---
<Base title="Journal" description="Daily notes from Ali Khalaf: what is being built, learned and played.">
  <div class="wrap stack">
    <header class="page-head has-tone">
      <Sfx word="LOG" rotate="-5deg" look="rough" />
      <Kicker />
      <h1>Journal</h1>
      <Bubble shape="round" as="p" class="lede bubble--up">Short daily notes.</Bubble>
    </header>
    <p><a class="btn" href="/rss.xml"><Icon name="rss" />RSS</a></p>
    {
      tags.length > 0 && (
        <ul class="chips" aria-label="Filter by tag">
          {tags.map((t) => (
            <li><a href={`/journal/tag/${tagSlug(t)}/`}>{t}</a></li>
          ))}
        </ul>
      )
    }
    {
      entries.length === 0 ? (
        <Panel tone="fine" shadow>
          <div class="panel__body strips-empty"><Bubble shape="caption" as="p">No entries yet.</Bubble></div>
        </Panel>
      ) : (
        <ol class="strips">
          {entries.map((e, i) => <Strip href={`/journal/${e.id}/`} date={e.data.date} text={excerpt(e.body ?? '', 220)} index={i} />)}
        </ol>
      )
    }
  </div>
</Base>
