---
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DateStamp from '../../components/DateStamp.astro';
import Bubble from '../../components/Bubble.astro';
import Panel from '../../components/Panel.astro';
import { firstSentence, neighbors, newestFirst, tagSlug } from '../../lib/journal';
import { formatDay } from '../../lib/dates';
import { dropcap, published } from '../../lib/content';

export async function getStaticPaths() {
  const entries = newestFirst(published(await getCollection('journal')));
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, entries } }));
}

const { entry, entries } = Astro.props;
const { Content } = await render(entry);
const { newer, older } = neighbors(entries, entry.id);

const games = published(await getCollection('games'));
const lab = published(await getCollection('lab'));
const project = entry.data.project;
const projectHref = !project
  ? undefined
  : games.some((g) => g.id === project)
    ? `/personal/games/${project}/`
    : lab.some((l) => l.id === project)
      ? `/personal/lab/${project}/`
      : undefined;
---
<Base title={`${formatDay(entry.data.date)} | Journal`} description={firstSentence(entry.body ?? '')}>
  <article class="wrap stack">
    <p><a class="btn btn--back" href="/journal/"><Icon name="arrow-left" />Journal</a></p>
    <DateStamp date={entry.data.date} as="h1" />
    <div class="project project--entry">
      <aside class="project__aside">
        <Panel weight={4} tone="fine" shadow class="facts-panel">
          <div class="panel__body">
            <div class="panel__caps">
              <Bubble shape="caption" as="span">Journal entry</Bubble>
            </div>
            {
              entry.data.tags.length > 0 && (
                <ul class="chips" aria-label="Tags">
                  {entry.data.tags.map((t) => (
                    <li><a href={`/journal/tag/${tagSlug(t)}/`}>{t}</a></li>
                  ))}
                </ul>
              )
            }
            {projectHref && <p><a class="btn" href={projectHref}><Icon name="arrow-right" />About {project}</a></p>}
            {(older || newer) && <nav class="entry-nav" aria-label="More entries">
              {older && <a class="btn" href={`/journal/${older.id}/`}><Icon name="arrow-left" />Older: {formatDay(older.data.date)}</a>}
              {newer && <a class="btn" href={`/journal/${newer.id}/`}>Newer: {formatDay(newer.data.date)}<Icon name="arrow-right" /></a>}
            </nav>}
          </div>
        </Panel>
      </aside>
      <div class="project__main">
        <Panel weight={4} shadow>
          <div class="panel__body entry-panel">
            <div class={dropcap(entry.body)}><Content /></div>
          </div>
        </Panel>
      </div>
    </div>
  </article>
</Base>
